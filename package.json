{
  "name": "pine-funcoes-web",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright para login web do Banco Pine com Microsoft Edge",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node Scripts/run-env.mjs homologacao --project=edge",
    "test:login": "node Scripts/run-env.mjs homologacao --project=edge Tests/Login.Test.ts",
    "test:homologacao": "node Scripts/run-env.mjs homologacao --project=edge",
    "test:edge": "node Scripts/run-env.mjs homologacao --project=edge",
    "test:list": "node Scripts/run-env.mjs homologacao --project=edge --list",
    "test:ui": "node Scripts/run-env.mjs homologacao --project=edge --ui",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.15.3",
    "typescript": "^6.0.2"
  }
}
